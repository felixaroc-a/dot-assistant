{
  "dashboard": {
    "uid": "dot-whatsapp",
    "title": "DOT — WhatsApp",
    "description": "Mensajes entrantes/salientes, tasa de entrega, profundidad de cola",
    "tags": ["dot", "whatsapp", "messaging"],
    "timezone": "browser",
    "schemaVersion": 39,
    "version": 1,
    "refresh": "15s",
    "panels": [
      {
        "id": 1,
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
        "title": "Mensajes WhatsApp por dirección (rate 1m)",
        "type": "timeseries",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "targets": [
          {
            "expr": "rate(dot_whatsapp_messages_total[1m])",
            "legendFormat": "{{direction}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "msgps",
            "custom": { "lineInterpolation": "smooth", "fillOpacity": 20, "stacking": { "mode": "normal" } }
          }
        }
      },
      {
        "id": 2,
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
        "title": "Total mensajes acumulados",
        "type": "timeseries",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "targets": [
          {
            "expr": "dot_whatsapp_messages_total",
            "legendFormat": "{{direction}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "custom": { "lineInterpolation": "smooth", "fillOpacity": 10 }
          }
        }
      },
      {
        "id": 3,
        "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
        "title": "Mensajes inbound (total)",
        "type": "stat",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "targets": [
          {
            "expr": "dot_whatsapp_messages_total{direction=\"inbound\"}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": { "unit": "short" }
        }
      },
      {
        "id": 4,
        "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
        "title": "Mensajes outbound (total)",
        "type": "stat",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "targets": [
          {
            "expr": "dot_whatsapp_messages_total{direction=\"outbound\"}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": { "unit": "short" }
        }
      },
      {
        "id": 5,
        "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
        "title": "Tasa de entrega (outbound/inbound)",
        "type": "stat",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "targets": [
          {
            "expr": "rate(dot_whatsapp_messages_total{direction=\"outbound\"}[5m]) / rate(dot_whatsapp_messages_total{direction=\"inbound\"}[5m])",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": { "unit": "percentunit", "decimals": 2 }
        }
      },
      {
        "id": 6,
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
        "title": "Automatizaciones WhatsApp",
        "type": "timeseries",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "targets": [
          {
            "expr": "rate(dot_automation_executions_total{name=~\".*whatsapp.*|.*wa.*\"}[5m])",
            "legendFormat": "{{name}} ({{status}})",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ops",
            "custom": { "lineInterpolation": "smooth", "fillOpacity": 15 }
          }
        }
      },
      {
        "id": 7,
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
        "title": "Ratio inbound/outbound",
        "type": "timeseries",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "targets": [
          {
            "expr": "rate(dot_whatsapp_messages_total{direction=\"outbound\"}[5m]) / rate(dot_whatsapp_messages_total{direction=\"inbound\"}[5m])",
            "legendFormat": "Ratio",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "custom": { "lineInterpolation": "smooth", "fillOpacity": 20 },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "green", "value": 0.5 },
                { "color": "yellow", "value": 2.0 }
              ]
            }
          }
        }
      }
    ],
    "templating": {
      "list": [
        {
          "name": "DS_PROMETHEUS",
          "type": "datasource",
          "query": "prometheus",
          "current": { "text": "Prometheus", "value": "Prometheus" }
        }
      ]
    }
  }
}
