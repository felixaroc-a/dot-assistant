# Variables de entorno para el frontend Nordik IA (Vite + React)
# Copiar a .env y ajustar segun el entorno

# Obligatoria: URL del backend API
VITE_API_BASE_URL=http://127.0.0.1:8000

# Opcional: URL del WebSocket (por defecto ws://127.0.0.1:8000)
# VITE_WS_URL=ws://127.0.0.1:8000

# Opcional: 1 oculta #/provisioner en dev del cliente
# VITE_PANEL_ONLY_USB=1

# Opcional: 1 en build de la app Provisioner (soporte interno)
# VITE_DOT_PROVISIONER=1

# Opcional: misma que ADMIN_API_KEY del backend, para app soporte
# VITE_ADMIN_API_KEY=

# Opcional: CSV de paquetes npm OpenClaw (Gmail/Calendar)
# ─────────────────────────────────────────────
# Modo Demo (desarrollo)
# ─────────────────────────────────────────────

# E05: Omite la verificacion de pendrive USB en desarrollo.
# NUNCA establezcas esto en produccion (app empaquetada lo ignora).
# El proceso Electron lee DOT_DEMO_MODE; Vite lee VITE_DOT_DEMO_MODE.
# DOT_DEMO_MODE=1
# VITE_DOT_DEMO_MODE=1

# Solo desarrollo: misma secret JWT que el backend (JWT_SECRET en backend/.env).
# Permite crear JWTs dev sin login real. NUNCA en producción.
# VITE_DEV_JWT_SECRET=

# Acceso completo al disco en Electron (solo DEV; empaquetado lo ignora).
# También se activa si DOT_DEMO_MODE=1. El backend usa las mismas vars para el prompt.
# DOT_FULL_DISK_ACCESS=1

# ─────────────────────────────────────────────
# Auto-updater (Electron) — D03
#
# El cliente Electron lee estas variables via load-backend-env.cjs
# que carga backend/.env. Para desarrollo local, configura estas
# variables en apps/dot/backend/.env
# ─────────────────────────────────────────────

# URL del feed generico de actualizaciones (provider: generic)
# Apunta al bucket GCS: gs://nordik-releases/latest/
# En produccion con dominio propio: https://releases.nordikia.com/updates/latest/
# DOT_UPDATER_URL=https://storage.googleapis.com/nordik-releases/latest/

# Canal del feed (default: latest). Ej: latest, beta, stable
# DOT_UPDATER_CHANNEL=latest

# Habilita/deshabilita auto-update (default: true)
# false para desarrollo o builds de prueba
# DOT_AUTO_UPDATE_ENABLED=true

# Permite prereleases (default: false)
# DOT_UPDATER_ALLOW_PRERELEASE=false

# ── Alternativa: GitHub Releases (provider: github) ──
# Si no usas feed generico, configura owner/repo de GitHub
# DOT_UPDATER_GH_OWNER=
# DOT_UPDATER_GH_REPO=

# true si el repo es privado
# DOT_UPDATER_GH_PRIVATE=false

# GitHub token con acceso a releases (solo si repo privado)
# DOT_UPDATER_GH_TOKEN=
# GH_TOKEN=

# ─────────────────────────────────────────────
# Planificador multi-paso (PL01-PL06)
# Variables leídas por el backend (apps/dot/backend/.env)
# ─────────────────────────────────────────────

# Habilita el planificador multi-paso (prefix "plan:" en chat).
# Desactivado por defecto. Activar para desarrollo/testing de PL01-PL06.
# PLANNER_ENABLED=1

# Usa DeepSeek (LLM barato) para generar el plan en vez de heurística.
# Requiere PLANNER_ENABLED=1 y DEEPSEEK_API_KEY configurado.
# PLANNER_LLM=1

# Activa reflexión post-paso: re-evalúa y ajusta pasos restantes si uno falla.
# Requiere PLANNER_ENABLED=1.
# PLANNER_REFLECT=1

# Si un paso falla, continúa con los siguientes en vez de abortar el plan.
# Requiere PLANNER_ENABLED=1.
# PLANNER_CONTINUE_ON_ERROR=1
