{
  "name": "dot-frontend",
  "private": true,
  "version": "0.0.0",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --config config/vite.config.ts",
    "setup": "npm install --ignore-scripts && node scripts/download-electron.mjs",
    "setup:env:vite": "node scripts/sync-vite-env-from-service-account.mjs",
    "setup:env:backend": "node scripts/sync-vite-env-from-backend.mjs",
    "desktop": "cross-env NODE_ENV=development concurrently -k \"vite --host 127.0.0.1 --config config/vite.config.ts\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "desktop:no-usb": "cross-env NODE_ENV=development DOT_DEMO_MODE=1 DOT_FULL_DISK_ACCESS=1 VITE_DOT_DEMO_MODE=1 VITE_DOT_SKIP_USB_GATE=1 concurrently -k \"vite --host 127.0.0.1 --config config/vite.config.ts\" \"wait-on http://127.0.0.1:5173 && cross-env DOT_DEMO_MODE=1 DOT_FULL_DISK_ACCESS=1 electron .\"",
    "build": "tsc -b && vite build --config config/vite.config.ts",
    "electron:repair": "node scripts/download-electron.mjs",
    "desktop:dist": "node scripts/embed-electron-secrets.mjs && npm run build && electron-builder --config config/electron-builder.yml",
    "dist:win": "npm run build && electron-builder --win --config config/electron-builder.yml",
    "desktop:build:mac": "npm run build && electron-builder --mac --config config/electron-builder.yml",
    "desktop:build:linux": "npm run build && electron-builder --linux --config config/electron-builder.yml",
    "desktop:installer": "npm run desktop:dist && node scripts/build-installer.mjs",
    "desktop:installer:dry": "node scripts/build-installer.mjs --dry-run",
    "lint": "eslint --config config/eslint.config.js .",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "preview": "vite preview --config config/vite.config.ts",
    "desktop:build:local": "cross-env VITE_API_BASE_URL=http://127.0.0.1:8000 VITE_DOT_DEMO_MODE=1 VITE_DOT_SKIP_USB_GATE=1 npx vite build --mode development --config config/vite.config.ts",
    "desktop:preview": "npm run desktop:build:local && cross-env NODE_ENV=development DOT_DEMO_MODE=1 DOT_FULL_DISK_ACCESS=1 VITE_DOT_DEMO_MODE=1 VITE_DOT_SKIP_USB_GATE=1 VITE_API_BASE_URL=http://127.0.0.1:8000 concurrently -k \"vite preview --host 127.0.0.1 --port 5173 --config config/vite.config.ts\" \"wait-on http://127.0.0.1:5173 && cross-env NODE_ENV=development DOT_DEMO_MODE=1 DOT_FULL_DISK_ACCESS=1 VITE_API_BASE_URL=http://127.0.0.1:8000 electron .\"",
    "desktop:dev": "npm run desktop:preview",
    "api:types": "openapi-typescript http://127.0.0.1:8000/openapi.json -o src/lib/api/types/openapi.d.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:backend": "cd ../backend && python -m pytest app/tests/ -q",
    "test:coverage": "cd ../backend && python -m pytest app/tests/ --cov=app --cov-report=html --cov-report=term",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "backend:preflight": "cd ../backend && python scripts/preflight_config.py --strict",
    "backend:dev": "cd ../backend && python -m uvicorn app.main:app --reload --host 127.0.0.1 --port 8000",
    "worker:dev": "cd ../backend && python -m worker.worker_main --interval 3",
    "backend:dev:all": "concurrently -k -n api,worker \"npm run backend:dev\" \"npm run worker:dev\"",
    "backend:db-init": "cd ../backend && python scripts/init_billing_db.py",
    "billing:ensure-schema": "cd ../backend && python scripts/ensure_billing_schema.py",
    "usb:provision-delivery": "node scripts/provision-pendrive-delivery.cjs",
    "usb:diagnose": "node scripts/diagnose-usb-drives.cjs",
    "postinstall": "electron-rebuild -f -w better-sqlite3 -w isolated-vm"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --config config/eslint.config.js --fix",
      "prettier --write --ignore-unknown 2>/dev/null || true"
    ],
    "*.py": [
      "cd ../../.. && ruff check --fix",
      "cd ../../.. && ruff format 2>/dev/null || true"
    ]
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.23",
    "@xenova/transformers": "^2.17.0",
    "better-sqlite3": "^13.0.1",
    "electron-updater": "^6.8.3",
    "framer-motion": "^12.5.0",
    "i18next": "^24.0.0",
    "idb": "^8.0.3",
    "isolated-vm": "^7.0.0",
    "mammoth": "^1.12.0",
    "node-cron": "^3.0.3",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.0.0",
    "react-router-dom": "^7.18.0",
    "unpdf": "^1.6.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.0",
    "@eslint/js": "^9.21.0",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.10",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^40.4.0",
    "electron-builder": "^26.8.1",
    "electron-rebuild": "^3.2.9",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.8",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.2.0",
    "vitest": "^4.1.8",
    "wait-on": "^8.0.5"
  }
}
